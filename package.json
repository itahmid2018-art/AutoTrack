{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "clean": "node -e \"const fs=require('fs');['dist','dist-server'].forEach((p)=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --platform=node --format=cjs --target=node20 --bundle --packages=external --outfile=dist-server/server.cjs",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "start": "node dist-server/server.cjs",
    "lint": "tsc --noEmit",
    "validate:sql": "node scripts/validate_sql.js",
    "test": "npx tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke_prod.mjs"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
